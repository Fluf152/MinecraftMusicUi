<Window x:Class="MinecraftMusicUi.Windows.DiscAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MinecraftMusicUi.Windows"
        mc:Ignorable="d"
        Title="DiscAddWindow" Height="460" Width="371"
        Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <ImageBrush Opacity="0.50" ImageSource="/MinecraftMusicUi;component/Resources/Images/MainBodyBackground.png"/>
        </Grid.Background>
        <StackPanel Orientation="Horizontal"
                    Grid.Row="0">
            <TextBox Style="{DynamicResource MinecraftTextBox}"
                 Width="200"
                 Height="40"
                 HorizontalAlignment="Left"
                 Margin="10"/>
            <TextBlock Style="{DynamicResource MinecraftTextBlock}"
                       Text="Название"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal"
            Grid.Row="1">
            <TextBox Style="{DynamicResource MinecraftTextBox}"
         Width="200"
         Height="40"
         HorizontalAlignment="Left"
         Margin="10"/>
            <TextBlock Style="{DynamicResource MinecraftTextBlock}"
               Text="Автор"
               VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal"
            Grid.Row="0">
            <TextBox Style="{DynamicResource MinecraftTextBox}"
         Width="200"
         Height="40"
         HorizontalAlignment="Left"
         Margin="10"/>
            <TextBlock Style="{DynamicResource MinecraftTextBlock}"
               Text="Название"
               VerticalAlignment="Center"/>
        </StackPanel>

        <Button Style="{DynamicResource MinecraftButton}"
                Grid.Row="4"
                Width="120"
                Height="40"
                HorizontalAlignment="Right"
                Margin="10"
                Content="Добавить"/>
    </Grid>
</Window>
